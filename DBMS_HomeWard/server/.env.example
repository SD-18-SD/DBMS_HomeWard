# Copy this file to .env and fill in your own values.

# Port the API listens on
PORT=5000

# Local MongoDB (MongoDB Community Server)
MONGO_URI=mongodb://127.0.0.1:27017/homeward
# Or MongoDB Atlas, for example:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/homeward

# Long random string used to sign login tokens. Change this!
JWT_SECRET=change-me-to-a-long-random-string

# How long a login lasts
JWT_EXPIRES_IN=7d

# Where the React app runs (used for CORS)
CLIENT_URL=http://localhost:5173

# development or production
NODE_ENV=development

# Used by "npm run seed" to create the first admin account
ADMIN_EMAIL=admin@homeward.test
ADMIN_PASSWORD=Admin@12345
